# ─────────────────────────────────────────────────────────────────────────────
#  Environment variables for for-xavier-c
#
#  Copy this file to .env.local and fill in your values.
#  .env.local is gitignored and will never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Cloudflare R2 public URL for audio files.
#
# Leave blank to use local public/songs/ (default for local dev).
# For production, set this in the Vercel dashboard instead of here.
#
# Where to find your URL (choose one):
#   a) R2 bucket with public access:   https://pub-xxxxxxxx.r2.dev
#   b) Custom domain via Cloudflare:   https://music.yoursite.com
#
VITE_CDN_BASE=

# ── Optional: OpenWeatherMap API key ─────────────────────────────────────────
#
# If set, weather data is fetched from OpenWeatherMap instead of the
# default Open-Meteo provider.
#
# Open-Meteo is always used when this key is absent or blank:
#   • Free, no sign-up, no API key.
#   • Accurate — used by the app out of the box.
#
# To use OpenWeatherMap:
#   1. Sign up at https://openweathermap.org/appid (free tier available)
#   2. Copy your API key below.
#   3. New keys take up to 2 hours to activate.
#   4. For production, set VITE_OPENWEATHER_KEY in the Vercel dashboard.
#
# If location permission is denied, weather is not fetched regardless of
# which provider is configured — the app falls back to time-only mode.
#
VITE_OPENWEATHER_KEY=
